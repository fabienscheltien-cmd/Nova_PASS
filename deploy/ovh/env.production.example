# Copier vers /opt/nova-pass/.env.production (chmod 600) — ne jamais committer ce fichier.
# Les variables VITE_* sont lues au moment du build (npm run build:ovh) : refaire le
# build après toute modification de l'une d'elles.

# --- Supabase : VOTRE projet (Project Settings › API) ---
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète, côté serveur uniquement (service_role ou sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# Les mêmes URL et clé publique pour le navigateur (sinon il resterait sur la base Lovable)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=VOTRE-PROJET

# --- Adresse publique : les QR codes y pointent ---
VITE_URL_PUBLIQUE=https://novapass.nova-serenity.fr

# --- Lien d'avis Google (étoiles après l'enregistrement d'un visiteur) ---
# Lien « Demander des avis » de la fiche Google Business Profile ; laisser vide sinon.
VITE_URL_AVIS_GOOGLE=

# --- E-mail d'accueil via SMTP OVH (adresse créée dans l'espace client OVH) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=accueil@nova-serenity.fr
SMTP_PASSWORD=
SMTP_FROM="Nova Pass <accueil@nova-serenity.fr>"

# --- Serveur Node ---
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
