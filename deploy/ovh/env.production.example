# Copier vers /opt/nova-pass/.env.production (chmod 600) — ne jamais committer ce fichier.

# --- Supabase (Settings > API du projet Supabase) ---
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète côté serveur uniquement (service_role ou sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail d'accueil via SMTP OVH (adresse créée dans l'espace client OVH) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=accueil@votre-domaine.fr
SMTP_PASSWORD=
SMTP_FROM="Nova Pass <accueil@votre-domaine.fr>"

# --- Serveur Node ---
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
